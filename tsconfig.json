{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": [],
    "jsx": "react-jsx"
  },
  "include": [
    "apps/worker/src/**/*.ts",
    "apps/console/src/**/*.tsx",
    "apps/console/src/**/*.ts"
  ]
}
